  "components": {
    "schemas": {
      "AppState": {
        "properties": {
          "root": {
            "type": "string",
            "title": "Root"
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array",
            "title": "Projects"
          },
          "focused_project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focused Project"
          },
          "ui": {
            "$ref": "#/components/schemas/UiState"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/Tool"
            },
            "type": "array",
            "title": "Tools",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "root",
          "projects",
          "focused_project",
          "ui"
        ],
        "title": "AppState",
        "description": "Everything the UI shows, in one piece."
      },
      "Focus": {
        "properties": {
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          }
        },
        "type": "object",
        "required": [
          "slug"
        ],
        "title": "Focus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Layout": {
        "properties": {
          "tree": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Split-Input"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tree"
          }
        },
        "type": "object",
        "required": [
          "tree"
        ],
        "title": "Layout"
      },
      "Page": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "Page",
        "description": "What a web pane shows."
      },
      "PageVersion": {
        "properties": {
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "PageVersion",
        "description": "Tells a web pane when to load its page again."
      },
      "Pane": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "kind": {
            "type": "string",
            "enum": [
              "terminal",
              "web"
            ],
            "title": "Kind",
            "default": "terminal"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "values": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Values",
