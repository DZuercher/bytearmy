  "components": {
    "schemas": {
      "AppState": {
        "properties": {
          "root": {
            "type": "string",
            "title": "Root"
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array",
            "title": "Projects"
          },
          "focused_project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focused Project"
          },
          "ui": {
            "$ref": "#/components/schemas/UiState"
          }
        },
        "type": "object",
        "required": [
          "root",
          "projects",
          "focused_project",
          "ui"
        ],
        "title": "AppState",
        "description": "Everything the UI shows, in one piece."
      },
      "Focus": {
        "properties": {
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          }
        },
        "type": "object",
        "required": [
          "slug"
        ],
        "title": "Focus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Project": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "github_url": {
            "type": "string",
            "title": "Github Url",
            "default": ""
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "backlog": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array",
            "title": "Backlog"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array",
            "title": "Tasks"
          },
          "focused_task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focused Task"
          }
        },
        "type": "object",
        "required": [
          "name",
          "slug",
          "path",
          "backlog",
          "tasks",
          "focused_task"
        ],
        "title": "Project"
      },
      "ProjectMeta": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "github_url": {
            "type": "string",
            "title": "Github Url",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProjectMeta",
        "description": "What the user says about a project."
      },
      "ProjectOrder": {
        "properties": {
          "order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Order"
          }
        },
        "type": "object",
        "required": [
          "order"
        ],
        "title": "ProjectOrder"
      },
      "Task": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "branch": {
            "type": "string",
            "title": "Branch",
            "default": ""
          },
          "reminder": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reminder"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dependencies",
            "default": []
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "Backlog"
          },
          "repo": {
            "type": "string",
            "title": "Repo",
            "default": ""
          },
          "clone_error": {
            "type": "string",
            "title": "Clone Error",
            "default": ""
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "clone": {
            "type": "string",
            "enum": [
              "none",
              "cloning",
              "ready",
              "failed"
            ],
            "title": "Clone"
          },
          "reminder_due": {
            "type": "boolean",
            "title": "Reminder Due"
          },
          "blocked_by": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Blocked By"
          }
        },
        "type": "object",
        "required": [
          "name",
          "slug",
          "path",
          "clone",
          "reminder_due",
          "blocked_by"
        ],
        "title": "Task"
      },
      "TaskCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "branch": {
            "type": "string",
            "title": "Branch",
            "default": ""
          },
          "reminder": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reminder"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dependencies",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "TaskCreate",
        "description": "What the user says about a task."
      },
      "TaskOrder": {
        "properties": {
          "bar": {
            "type": "string",
            "enum": [
              "backlog",
              "tasks"
            ],
            "title": "Bar"
          },
          "order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Order"
          }
        },
        "type": "object",
        "required": [
          "bar",
          "order"
        ],
        "title": "TaskOrder"
      },
      "UiChange": {
        "properties": {
          "left_open": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Left Open"
          },
          "right_open": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Right Open"
          },
          "bottom_open": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bottom Open"
          }
        },
        "type": "object",
        "title": "UiChange",
        "description": "The bars to open or close; a bar that is not named keeps its state."
      },
      "UiState": {
        "properties": {
          "left_open": {
            "type": "boolean",
            "title": "Left Open",
            "default": true
          },
          "right_open": {
            "type": "boolean",
            "title": "Right Open",
            "default": true
          },
          "bottom_open": {
            "type": "boolean",
            "title": "Bottom Open",
            "default": true
          }
        },
        "type": "object",
        "title": "UiState"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
